# Template for your own .env file.
#
# 1. Copy this file and name the copy ".env" (in this same Project2 folder):
#        Windows PowerShell:   Copy-Item .env.example .env
#        Mac / Linux:          cp .env.example .env
# 2. Fill in your own keys below. No quotes, no spaces around "=".
# 3. NEVER commit .env. It is listed in .gitignore. Only this template goes in git.
#
# The scripts load .env automatically (needs: pip install python-dotenv).

# Needed for ai_model.py. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Needed only for build.py (downloading Wikipedia data). Get a token at
# https://huggingface.co/settings/tokens (read access is enough). Leave it blank if you're not rebuilding the data.
HF_TOKEN=
